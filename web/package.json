{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node --import tsx scripts/dev-local.ts",
    "seed:local": "node --import tsx scripts/seed-local.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:css": "node scripts/check-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.3",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@next/env": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
