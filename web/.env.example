# Copy to .env.local and fill in. Never commit real values.

# Supabase Postgres, *transaction pooler* URL (port 6543). TLS is always on and verified in code
# (src/db/index.ts); `sslmode` here is informational, any ssl* parameters are ignored.
DATABASE_URL=postgres://postgres.xxxxxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase root CA (PEM). REQUIRED for Supabase: its certificates chain to Supabase's own CA,
# which Node does not trust, so connections fail closed without it. Download it from
# Dashboard > Database settings > SSL Configuration. Multi-line, or one line with \n escapes.
DATABASE_CA_CERT=

# Google OAuth client (Web application). Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HS256 signing key for the session JWT. At least 32 characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Resend API key for transactional email.
RESEND_API_KEY=

# Shared secret the cron trigger sends as `Authorization: Bearer <CRON_SECRET>`.
# At least 32 characters, e.g. `openssl rand -base64 36`.
CRON_SECRET=

# Public origin of this app: scheme://host[:port] only, no path or trailing slash.
APP_URL=http://localhost:3000

# Optional. Comma-separated admin emails (case-insensitive).
ADMIN_EMAILS=
